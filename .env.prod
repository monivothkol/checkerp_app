VITE_COMPANY_NAME="CHECKERP"
VITE_ENVIRONMENT="production"
VITE_SERVER_PROTOCOL="https"
VITE_SERVER_DOMAIN="nivotsit.cloud"
# no per-tenant subdomain for our backend (leave empty)
VITE_SERVER_SUB_DOMAIN=""
# TODO: confirm API context path with backend (requests go to https://nivotsit.cloud/{context}/{trCode})
VITE_SERVER_CONTEXT="api"
# TODO: confirm auth endpoints with backend (used by the IAM/token flow in network-servies)
VITE_AUTH_SERVER_URL="auth/api"
VITE_AUTH_2_SERVER_URL="auth/oauth2"
# TODO: confirm file/content path with backend (document upload, OCR)
VITE_SERVER_CONTENT="files"
VITE_ENABLE_MOCK_REQUEST=false
VITE_API_MOCK_URL="/mock/api"
VITE_USE_STATIC_PROXY=false
VITE_DISABLE_DYNAMIC_PROXY=false
VITE_PRINT_CURL="false"
# DBCS-style payload encryption handshake is OFF until our backend implements it
VITE_ENABLE_ENCRYPT="false"
# fill in when Google/Bakong features are needed
VITE_GOOGLE_MAPS_API_KEY_ANDROID=""
VITE_GOOGLE_MAPS_API_KEY_IOS=""
VITE_BAKONG_ACQUIRING_BANK=""
VITE_BAKONG_ACCOUNT_ID=""
VITE_BAKONG_QR_DOWNLOAD_EXPIRED_DATE=90

VITE_ENCRYPTION_SECRET="checkerp-prod-v1-at-rest-token-key"
